rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 가게 정보 관리자 수정본(메뉴/가격/사진). 누구나 읽지만, 지정된 관리자만 쓸 수 있음.
    match /shopOverrides/{shopId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'cmkim84@ajunews.com';
    }
  }
}
